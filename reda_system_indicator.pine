//@version=5
indicator("Reda System - Pre-Trade Checklist & Signals", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// ==========================================
// 1. INPUT SETTINGS
// ==========================================
group_macro = "1. Fundamental Macro Bias Settings"
fund_bias = input.string("Bullish", "Market Fundamental Bias", options=["Bullish", "Bearish", "Neutral / Auto"], group=group_macro, tooltip="Set your macroeconomic bias based on Fundamental Analysis (CPI, NFP, Interest Rates, News)")
news_context = input.string("Programmed News (CPI/NFP/FOMC)", "News Category Context", options=["Programmed News (CPI/NFP/FOMC)", "Headlines / Geopolitical", "No News Today"], group=group_macro)

group_session = "2. Session & Killzone Filter"
use_killzone = input.bool(true, "Strict Session Killzone Filter", group=group_session, tooltip="Signals are only triggered during London & New York high-liquidity sessions")
london_session = input.session("0700-1100:1234567", "London Session (UTC)", group=group_session)
ny_session = input.session("1300-1700:1234567", "New York Session (UTC)", group=group_session)

group_tech = "3. Technical & Orderflow Parameters"
ema_fast_len = input.int(20, "Fast EMA Length", group=group_tech)
ema_slow_len = input.int(50, "Slow EMA Length (HTF Trend)", group=group_tech)
pivot_len = input.int(3, "Pivot High/Low Lookback", group=group_tech)
show_fvg = input.bool(true, "Highlight Fair Value Gaps (FVG)", group=group_tech)
show_ob = input.bool(true, "Highlight Order Blocks (OB)", group=group_tech)

group_dash = "4. Pre-Trade Checklist Dashboard"
show_dash = input.bool(true, "Show Checklist Dashboard", group=group_dash)
dash_pos = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=group_dash)

// ==========================================
// 2. TECHNICAL CALCULATIONS & INDICATORS
// ==========================================
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

// Session Killzone Check
in_london = not na(time(timeframe.period, london_session))
in_ny = not na(time(timeframe.period, ny_session))
in_killzone = use_killzone ? (in_london or in_ny) : true

// Engulfing & Candle Close Check
bullish_engulfing = close > open[1] and close[1] < open[1] and close > open and (close - open) >= (open[1] - close[1])
bearish_engulfing = close < open[1] and close[1] > open[1] and close < open and (open - close) >= (close[1] - open[1])

// Pivot Highs / Lows & Structure
p_high = ta.pivothigh(high, pivot_len, pivot_len)
p_low = ta.pivotlow(low, pivot_len, pivot_len)

var float last_pivot_high = na
var float last_pivot_low = na

if not na(p_high)
    last_pivot_high := p_high

if not na(p_low)
    last_pivot_low := p_low

// Break of Structure (BOS)
bos_bull = not na(last_pivot_high) and close > last_pivot_high and close[1] <= last_pivot_high
bos_bear = not na(last_pivot_low) and close < last_pivot_low and close[1] >= last_pivot_low

// Liquidity Sweep (Wick Sweep below/above previous pivots)
sweep_bull = not na(last_pivot_low) and low < last_pivot_low and close > last_pivot_low
sweep_bear = not na(last_pivot_high) and high > last_pivot_high and close < last_pivot_high

// Fair Value Gap (FVG)
fvg_bull = low > high[2] and close[1] > high[2]
fvg_bear = high < low[2] and close[1] < low[2]

// Order Block (OB) detection
is_ob_bull = close > open and close[1] < open[1] and close > high[1]
is_ob_bear = close < open and close[1] > open[1] and close < low[1]

// ==========================================
// 3. PRE-TRADE CHECKLIST VALIDATION
// ==========================================
// Rule 1: Fundamental Bias Matching
cond_fund_bull = (fund_bias == "Bullish" or fund_bias == "Neutral / Auto")
cond_fund_bear = (fund_bias == "Bearish" or fund_bias == "Neutral / Auto")

// Rule 2: Technical Candle Close & Level Alignment
cond_tech_bull = (bullish_engulfing or close > ema_fast)
cond_tech_bear = (bearish_engulfing or close < ema_fast)

// Rule 3: Orderflow & Liquidity Mapping (BOS or Sweep)
cond_of_bull = (sweep_bull or bos_bull or fvg_bull)
cond_of_bear = (sweep_bear or bos_bear or fvg_bear)

// Rule 4: Point of Interest (POI) & Zone Alignment
cond_poi_bull = (close > ema_slow or fvg_bull or is_ob_bull)
cond_poi_bear = (close < ema_slow or fvg_bear or is_ob_bear)

// Rule 5: Session Killzone Timing
cond_kz = in_killzone

// ALL CHECKLIST ITEMS VALIDATION
all_bull_valid = cond_fund_bull and cond_tech_bull and cond_of_bull and cond_poi_bull and cond_kz
all_bear_valid = cond_fund_bear and cond_tech_bear and cond_of_bear and cond_poi_bear and cond_kz

// Signal Execution Flags
buy_signal = all_bull_valid and not all_bull_valid[1]
sell_signal = all_bear_valid and not all_bear_valid[1]

// Count score (0 to 5)
score_bull = (cond_fund_bull ? 1 : 0) + (cond_tech_bull ? 1 : 0) + (cond_of_bull ? 1 : 0) + (cond_poi_bull ? 1 : 0) + (cond_kz ? 1 : 0)
score_bear = (cond_fund_bear ? 1 : 0) + (cond_tech_bear ? 1 : 0) + (cond_of_bear ? 1 : 0) + (cond_poi_bear ? 1 : 0) + (cond_kz ? 1 : 0)

// ==========================================
// 4. CHART PLOTS & VISUALS
// ==========================================
plot(ema_fast, "EMA 20", color=color.new(#38bdf8, 0), linewidth=2)
plot(ema_slow, "EMA 50", color=color.new(#f59e0b, 0), linewidth=2)

// Signal Arrows
plotshape(buy_signal, title="REDA BUY Signal", style=shape.triangleup, location=location.belowbar, color=#22c55e, size=size.small, text="REDA BUY\n🚀")
plotshape(sell_signal, title="REDA SELL Signal", style=shape.triangledown, location=location.abovebar, color=#ef4444, size=size.small, text="🔻 REDA SELL")

// Background highlight for Killzones
bgcolor(in_killzone ? color.new(#a3e635, 96) : na, title="Killzone Session Background")

// Visual FVG Shapes
plotshape(show_fvg and fvg_bull, title="Bullish FVG", style=shape.diamond, location=location.belowbar, color=color.new(#22c55e, 30), size=size.tiny)
plotshape(show_fvg and fvg_bear, title="Bearish FVG", style=shape.diamond, location=location.abovebar, color=color.new(#ef4444, 30), size=size.tiny)

// ==========================================
// 5. PRE-TRADE CHECKLIST DASHBOARD TABLE
// ==========================================
var table_position = dash_pos == "Top Right" ? position.top_right : dash_pos == "Bottom Right" ? position.bottom_right : dash_pos == "Top Left" ? position.top_left : position.bottom_left

var table dash = table.new(table_position, 2, 7, bgcolor=color.new(#0d1117, 10), border_color=color.new(#21262d, 0), border_width=1)

if show_dash and barstate.islast
    // Header
    table.cell(dash, 0, 0, "✨ REDA SYSTEM", bgcolor=color.new(#161b22, 0), text_color=#facc15, text_size=size.small)
    table.cell(dash, 1, 0, "PRE-TRADE CHECKLIST", bgcolor=color.new(#161b22, 0), text_color=#facc15, text_size=size.small)
    
    // Row 1: Macro Bias
    table.cell(dash, 0, 1, "1. Fundamental Bias", text_color=#8b949e, text_size=size.tiny)
    table.cell(dash, 1, 1, fund_bias + " (" + news_context + ")", bgcolor=fund_bias == "Bullish" ? color.new(#22c55e, 80) : fund_bias == "Bearish" ? color.new(#ef4444, 80) : color.new(#eab308, 80), text_color=color.white, text_size=size.tiny)

    // Row 2: Technical Close
    bool tech_valid = fund_bias == "Bearish" ? cond_tech_bear : cond_tech_bull
    table.cell(dash, 0, 2, "2. Technical Close State", text_color=#8b949e, text_size=size.tiny)
    table.cell(dash, 1, 2, tech_valid ? "VALID ✓" : "WAIT ⏳", bgcolor=tech_valid ? color.new(#22c55e, 80) : color.new(#334155, 80), text_color=color.white, text_size=size.tiny)

    // Row 3: Orderflow & Liquidity
    bool of_valid = fund_bias == "Bearish" ? cond_of_bear : cond_of_bull
    table.cell(dash, 0, 3, "3. Liquidity & Orderflow", text_color=#8b949e, text_size=size.tiny)
    table.cell(dash, 1, 3, of_valid ? "SWEPT / BOS ✓" : "WAIT ⏳", bgcolor=of_valid ? color.new(#22c55e, 80) : color.new(#334155, 80), text_color=color.white, text_size=size.tiny)

    // Row 4: POI Alignment
    bool poi_valid = fund_bias == "Bearish" ? cond_poi_bear : cond_poi_bull
    table.cell(dash, 0, 4, "4. POI Zone Alignment", text_color=#8b949e, text_size=size.tiny)
    table.cell(dash, 1, 4, poi_valid ? "ZONE READY ✓" : "WAIT ⏳", bgcolor=poi_valid ? color.new(#22c55e, 80) : color.new(#334155, 80), text_color=color.white, text_size=size.tiny)

    // Row 5: Killzone Status
    table.cell(dash, 0, 5, "5. Killzone Window", text_color=#8b949e, text_size=size.tiny)
    table.cell(dash, 1, 5, in_killzone ? "IN KILLZONE 🟢" : "OUTSIDE 🔴", bgcolor=in_killzone ? color.new(#22c55e, 80) : color.new(#ef4444, 80), text_color=color.white, text_size=size.tiny)

    // Row 6: Final Execution Status
    int current_score = fund_bias == "Bearish" ? score_bear : score_bull
    bool is_ready = (fund_bias == "Bearish" ? all_bear_valid : all_bull_valid)
    table.cell(dash, 0, 6, "STATUS SCORE: " + str.tostring(current_score) + "/5", text_color=#ffffff, text_size=size.small)
    table.cell(dash, 1, 6, is_ready ? "🚀 EXECUTION READY" : "⚠️ NEED CONFLUENCE", bgcolor=is_ready ? color.new(#22c55e, 30) : color.new(#eab308, 30), text_color=is_ready ? #22c55e : #facc15, text_size=size.small)

// ==========================================
// 6. TRADINGVIEW ALERTS
// ==========================================
alertcondition(buy_signal, title="REDA SYSTEM - BUY Signal", message="🚀 REDA SYSTEM BUY SIGNAL VALIDATED! Check Stop-Loss & Risk Management.")
alertcondition(sell_signal, title="REDA SYSTEM - SELL Signal", message="🔻 REDA SYSTEM SELL SIGNAL VALIDATED! Check Stop-Loss & Risk Management.")
alertcondition(buy_signal or sell_signal, title="REDA SYSTEM - Any Signal", message="⚡ REDA SYSTEM PRE-TRADE CHECKLIST FULLY VALIDATED!")
